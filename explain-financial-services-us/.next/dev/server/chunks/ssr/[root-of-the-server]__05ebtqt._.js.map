nown as AMR Corporation and changed its name to American Airlines Group Inc. in December 2013. American Airlines Group Inc. was founded in 1926 and is headquartered in Fort Worth, Texas.","ceo":"Mr. Robert D. Isom Jr.","headquarters":"Fort Worth, TX","employees":138900,"founded":0,"website":"https://www.aa.com","price":13.35,"changePercent":1.28983,"marketCap":8829492224,"peRatio":43.064518,"forwardPE":6.0645432,"psRatio":0.1576864,"pbRatio":-2.1658015,"evToEbitda":8.751,"dividendYield":0,"beta":1.28,"high52Week":16.5,"low52Week":10.09,"avgVolume":66467590},"financials":[{"period":"FY2023","periodType":"annual","revenue":55993.99936,"grossProfit":12807.000064,"operatingIncome":3273.6,"netIncome":202.0,"ebitda":4092.0,"totalAssets":111987.99872,"totalDebt":34892.00128,"cashAndEquivalents":7912.0,"sharesOutstanding":661.385137,"eps":0.31,"dividendsPerShare":0,"capex":2799.699968,"operatingCashFlow":4865.999872}],"earnings":[],"analysts":[],"theses":[{"type":"bull","title":"Growth in Industrials","summary":"American Airlines Group, Inc. is well positioned to capture market share in Airlines.","priceTarget":16.02,"keyDrivers":["Market expansion","Product innovation"],"risks":["Competition","Macroeconomic factors"],"catalysts":["Earnings release","New product launch"],"conviction":"high"}]},"CMCSK":{"info":{"ticker":"CMCSK","name":"5553128","sector":"Technology","industry":"Other","description":"","ceo":"N/A","headquarters":"N/A, N/A","employees":0,"founded":0,"website":"","price":0,"changePercent":0,"marketCap":0,"peRatio":0,"forwardPE":0,"psRatio":0,"pbRatio":0,"evToEbitda":0,"dividendYield":0,"beta":1.0,"high52Week":0,"low52Week":0,"avgVolume":0},"financials":[{"period":"FY2023","periodType":"annual","revenue":1000.0,"grossProfit":400.0,"operatingIncome":160.0,"netIncome":100.0,"ebitda":200.0,"totalAssets":2000.0,"totalDebt":500.0,"cashAndEquivalents":100.0,"sharesOutstanding":1000.0,"eps":0,"dividendsPerShare":0,"capex":50.0,"operatingCashFlow":200.0}],"earnings":[],"analysts":[],"theses":[{"type":"bull","title":"Growth in Technology","summary":"5553128 is well positioned to capture market share in Other.","priceTarget":0.0,"keyDrivers":["Market expansion","Product innovation"],"risks":["Competition","Macroeconomic factors"],"catalysts":["Earnings release","New product launch"],"conviction":"high"}]},"LBTYK":{"info":{"ticker":"LBTYK","name":"Liberty Global Ltd.","sector":"Communication Services","industry":"Telecom Services","description":"Liberty Global Ltd., together with its subsidiaries, provides broadband internet, video, fixed-line telephony, and mobile communications services to residential and business customers in Europe. It offers intelligent WiFi and broadband internet services, such as ONE Connect, which enables fast and flexible introductions of new hardware and services, as well as cloud-to-cloud open API integration; Smart Security that provides network security, safe browsing and fraud prevention measures; Smart Home, which provides enhanced entertainment and home automation and security services; and Connect Box, an intelligent WiFi and telephony gateway. The company provides various tiers of digital video programming and audio services, as well as digital video recorders and multimedia home gateway systems; Horizon 5, a cloud-based, multi-screen entertainment platform that combines linear television, including recording and replay features and video-on-demand services; Replay TV, a multimedia gateway service; video-on-demand that provides subscribers with access to a broad library of movies and television series; Horizon Go, an online mobile app; and channels, including general entertainment, sports, movies, series, documentaries, lifestyles, news, adult, children, and ethnic and foreign channels. In addition, it offers postpaid and prepaid mobile services; circuit-switched telephony services; and personal call manager, unified messaging, and multiple lines for additional fees. Further, the company offers business services comprising voice, advanced data, video, wireless, cloud-based services, and mobile and fixed-mobile convergence services to small businesses, and medium and large enterprises, as well as on a wholesale basis to other operators. It operates in Belgium, Ireland, Slovakia, and internationally. Liberty Global Ltd. was founded in 2004 and is based in Hamilton, Bermuda.","ceo":"Mr. Michael Thomas Fries","headquarters":"Hamilton, N/A","employees":6636,"founded":0,"website":"https://www.libertyglobal.com","price":11.82,"changePercent":-0.92205,"marketCap":3996311552,"peRatio":0,"forwardPE":-3.538922,"psRatio":0.80216616,"pbRatio":0.42044604,"evToEbitda":10.139,"dividendYield":0,"beta":0.706,"high52Week":13.12,"low52Week":9.27,"avgVolume":1508285},"financials":[{"period":"FY2023","periodType":"annual","revenue":4981.899776,"grossProfit":3288.199936,"operatingIncome":914.88,"netIncome":-5463.000064,"ebitda":1143.6,"totalAssets":9963.799552,"totalDebt":9375.599616,"cashAndEquivalents":2008.0,"sharesOutstanding":149.668449,"eps":-16.06,"dividendsPerShare":0,"capex":249.0949888,"operatingCashFlow":1189.500032}],"earnings":[],"analysts":[],"theses":[{"type":"bull","title":"Growth in Communication Services","summary":"Liberty Global Ltd. is well positioned to capture market share in Telecom Services.","priceTarget":14.184,"keyDrivers":["Market expansion","Product innovation"],"risks":["Competition","Macroeconomic factors"],"catalysts":["Earnings release","New product launch"],"conviction":"high"}]},"DISH":{"info":{"ticker":"DISH","name":"DISH","sector":"Technology","industry":"Other","description":"","ceo":"N/A","headquarters":"N/A, N/A","employees":0,"founded":0,"website":"","price":0,"changePercent":0,"marketCap":0,"peRatio":0,"forwardPE":0,"psRatio":0,"pbRatio":0,"evToEbitda":0,"dividendYield":0,"beta":1.0,"high52Week":0,"low52Week":0,"avgVolume":0},"financials":[{"period":"FY2023","periodType":"annual","revenue":1000.0,"grossProfit":400.0,"operatingIncome":160.0,