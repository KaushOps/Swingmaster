any provides Trip.Biz, a digital first, full-service, corporate travel management business which provides technology-enabled solutions for organizations managing business travel. Additionally, it offers online advertising and financial services, such as marketing planning and travel media services; Omni-Channel Touchpoints for Users; and Open Platform for Ecosystem Partners. It operates under the Ctrip, Qunar, Trip.com, Travix, Travelfusion, and Skyscanner brand names. The company was formerly known as Ctrip.com International, Ltd. and changed its name to Trip.com Group Limited in October 2019. Trip.com Group Limited was founded in 1999 and is based in Singapore.","ceo":"Dr. Jianzhang  Liang Ph.D.","headquarters":"Singapore, N/A","employees":43574,"founded":0,"website":"https://group.trip.com","price":52.68,"changePercent":-1.29286,"marketCap":33172871168,"peRatio":7.5257144,"forwardPE":11.25956,"psRatio":0.53153986,"pbRatio":1.3834697,"evToEbitda":-0.326,"dividendYield":0.57,"beta":-0.035,"high52Week":78.99,"low52Week":48.48,"avgVolume":2987621},"financials":[{"period":"FY2023","periodType":"annual","revenue":62408.998912,"grossProfit":50287.0016,"operatingIncome":13291.1996928,"netIncome":33294.000128,"ebitda":16613.999616,"totalAssets":124817.997824,"totalDebt":31613.999104,"cashAndEquivalents":71854.997504,"sharesOutstanding":629.705222,"eps":7.0,"dividendsPerShare":0.3,"capex":3120.4499456000003,"operatingCashFlow":14378.999808}],"earnings":[],"analysts":[],"theses":[{"type":"bull","title":"Growth in Consumer Cyclical","summary":"Trip.com Group Limited is well positioned to capture market share in Travel Services.","priceTarget":63.215999999999994,"keyDrivers":["Market expansion","Product innovation"],"risks":["Competition","Macroeconomic factors"],"catalysts":["Earnings release","New product launch"],"conviction":"high"}]},"CTXS":{"info":{"ticker":"CTXS","name":"CTXS","sector":"Technology","industry":"Other","description":"","ceo":"N/A","headquarters":"N/A, N/