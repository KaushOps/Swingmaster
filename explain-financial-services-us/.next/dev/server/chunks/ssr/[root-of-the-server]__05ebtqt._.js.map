nc. was incorporated in 1998 and is headquartered in San Diego, California.","ceo":"Mr. Jacob  Thaysen Ph.D.","headquarters":"San Diego, CA","employees":8600,"founded":0,"website":"https://www.illumina.com","price":141.88,"changePercent":2.28534,"marketCap":21466443776,"peRatio":25.796364,"forwardPE":24.000515,"psRatio":4.8865113,"pbRatio":8.112064,"evToEbitda":19.788,"dividendYield":0,"beta":1.424,"high52Week":155.53,"low52Week":77.5,"avgVolume":1703237},"financials":[{"period":"FY2023","periodType":"annual","revenue":4392.999936,"grossProfit":3000.0,"operatingIncome":924.0000512,"netIncome":853.0,"ebitda":1155.000064,"totalAssets":8785.999872,"totalDebt":2544.0,"cashAndEquivalents":1155.000064,"sharesOutstanding":151.3,"eps":5.5,"dividendsPerShare":0,"capex":219.64999680000005,"operatingCashFlow":1128.0}],"earnings":[],"analysts":[],"theses":[{"type":"bull","title":"Growth in Healthcare","summary":"Illumina, Inc. is well positioned to capture market share in Diagnostics & Research.","priceTarget":170.256,"keyDrivers":["Market expansion","Product innovation"],"risks":["Competition","Macroeconomic factors"],"catalysts":["Earnings release","New product launch"],"conviction":"high"}]},"TRIP":{"info":{"ticker":"TRIP","name":"TripAdvisor, Inc.","sector":"Consumer Cyclical","industry":"Travel Services","description":"Tripadvisor, Inc., an online travel company, engages in the provision of travel guidance products and services worldwide. The company operates through three segments: Experiences, Hotels and Other, and TheFork. The Experiences segment operates an online travel agency for tours, activities, and attractions, and acts as travel guidance platforms for travelers to discover, generate, and share authentic user-generated content in the form of ratings and reviews and opinions for destinations, points-of-interest, experiences, accommodations, restaurants, and cruises. The Hotels and Other segment primarily consist of the Tripadvisor hotel and restaurant guidance platform, which include hotel metasearch, and related advertising offerings primarily for hotels and restaurants. TheFork segment provides an online marketplace, which enables diners to discover and book online reservations at restaurants. Tripadvisor, Inc. was founded in 2000 and is headquartered in Needham, Massachusetts.","ceo":"Mr. Matthew  Goldberg","headquarters":"Needham, MA","employees":2555,"founded":0,"website":"https://www.tripadvisor.com","price":10.45,"changePercent":-6.94568,"marketCap":1215974144,"peRatio":95.0,"forwardPE":6.3948793,"psRatio":0.6484504,"pbRatio":1.8544809,"evToEbitda":10.027,"dividendYield":0,"beta":0.914,"high52Week":20.16,"low52Week":9.01,"avgVolume":3952644},"financials":[{"period":"FY2023","periodType":"annual","revenue":1875.2,"grossProfit":1181.100032,"operatingIncome":107.04,"netIncome":18.6,"ebitda":133.8,"totalAssets":3750.4,"totalDebt":1246.099968,"cashAndEquivalents":1120.4,"sharesOutstanding":116.361169,"eps":0.11,"dividendsPerShare":0,"capex":93.76,"operatingCashFlow":261.1}],"earnings":[],"analysts":[],"theses":[{"type":"bull","title":"Growth in Consumer Cyclical","summary":"TripAdvisor, Inc. is well positioned to capture market share in Travel Services.","priceTarget":12.54,"keyDrivers":["Market expansion","Product innovation"],"risks":["Competition","Macroeconomic factors"],"catalysts":["Earnings release","New product launch"],"conviction":"high"}]},"TSCO":{"info":{"ticker":"TSCO","name":"Tractor Supply Company","sector":"Consumer Cyclical","industry":"Specialty Retail","description":"Tractor Supply Company operates as a rural lifestyle retailer in the United States. The company provides various merchandise, including livestock and equine feed and equipment, poultry, fencing, and sprayers and chemicals; companion animal products, such as food, treats, and equipment for dogs, cats, and other small animals, as well as dog wellness products; seasonal and recreation products comprising tractors and riders, lawn and garden, bird feeding, power equipment, and other recreational products; truck, tool, and hardware products, such as truck accessories, trailers, generators, lubricants, batteries, and hardware and tools; and clothing, gift, and décor products consist of clothing, footwear, toys, snacks, and decorative merchandise. It offers its products under the 4health, Paws & Claws, American Farmworks, Producer's Pride, Bit & Bridle, Red Shed, Blue Mountain, Redstone, C.E. Schmidt, Retriever, Country Lane, Ridgecut, Countyline, Royal Wing, Country Tuff, Strive, Dumor, Traveller, Farm Table, Treeline, Groundwork, TSC Tractor Supply Co, Huskee, Untamed, JobSmart, and Impeckable brand names. The company operates its retail stores under the Tractor Supply Company, Petsense by Tractor Supply, and Orscheln Farm and Home names; and operates websites under the TractorSupply.com and Petsense.com names. It sells its products to recreational farmers, ranchers, and others. Tractor Supply Company was founded in 1938 and is based in Brentwood, Tennessee.","ceo":"Mr. Harry A. Lawton III","headquarters":"Brentwood, TN","employees":52000,"founded":0,"website":"https://www.tractorsupply.com","price":30.65,"changePercent":-3.43415,"marketCap":16074380288,"peRatio":15.098522,"forwardPE":13.24466,"psRatio":1.0271734,"pbRatio":6.2576566,"evToEbitda":11.431,"dividendYield":3.13,"beta":0.503,"high52Week":63.99,"low52Week":30.58,"avgVolume":8116437},"financials":[{"period":"FY2023","periodType":"annual","revenue":15649.139712,"grossProfit":5700.271104,"operatingIncome":1561.7728512,"netIncome":1081.241984,"ebitda":1952.216064,"totalAssets":31298.279424,"totalDebt":6408.77824,"cashAndEquivalents":224.268992,"sharesOutstanding":524.449616,"eps":2.03,"dividendsPerShare":0.96,"capex":782.4569856,"operatingCashFlow":1509.603968}],"earnings":[],"analysts":[],"theses":[{"type":"bull","title":"Growth in Consumer Cyclical","summary":"Tractor Supply Company is well positioned to capture market share in Specialty Retail.","p