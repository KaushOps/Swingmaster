tions, as well as global traffic management, site acceleration, application load balancing, large-scale load testing, and real-user monitoring; and media delivery solutions, including video streaming and video player services, game and software delivery, broadcast operations, authoritative domain name system, resolution, and data and analytics. Akamai Technologies, Inc. was incorporated in 1998 and is headquartered in Cambridge, Massachusetts.","ceo":"Dr. F. Thomson Leighton","headquarters":"Cambridge, MA","employees":11419,"founded":0,"website":"https://www.akamai.com","price":147.71,"changePercent":26.5833,"marketCap":21565661184,"peRatio":50.071186,"forwardPE":20.239765,"psRatio":5.0544763,"pbRatio":4.29452,"evToEbitda":23.028,"dividendYield":0,"beta":0.454,"high52Week":149.76,"low52Week":69.78,"avgVolume":5474783},"financials":[{"period":"FY2023","periodType":"annual","revenue":4266.646016,"grossProfit":2486.77888,"operatingIncome":917.5776256,"netIncome":435.179008,"ebitda":1146.972032,"totalAssets":8533.292032,"totalDebt":5867.704832,"cashAndEquivalents":930.444992,"sharesOutstanding":146.0,"eps":2.95,"dividendsPerShare":0,"capex":213.3323008,"operatingCashFlow":1580.07296}],"earnings":[],"analysts":[],"theses":[{"type":"bull","title":"Growth in Technology","summary":"Akamai Technologies, Inc. is well positioned to capture market share in Software - Infrastructure.","priceTarget":177.252,"keyDrivers":["Market expansion","Product innovation"],"risks":["Competition","Macroeconomic factors"],"catalysts":["Earnings release","New product launch"],"conviction":"high"}]},"DLTR":{"info":{"ticker":"DLTR","name":"Dollar Tree, Inc.","sector":"Consumer Defensive","industry":"Discount Stores","description":"Dollar Tree, Inc. operates retail discount stores under the Dollar Tree and Dollar Tree Canada brands in the United States and Canada. The company offers consumable merchandise comprising everyday consumables, such as household paper and chemicals, food, candy, health, 