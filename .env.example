# SwingMaster Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# Never commit .env to git (it's in .gitignore)

# ── API Security ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changeme_generate_a_strong_key
API_KEY_ENABLED=true

# ── LLM Keys ─────────────────────────────────────────────────────────────────
# Groq — primary (fastest, ~100ms, free tier)
# Round-robin key rotation is handled automatically in llm_analyst.py
GROQ_API_KEY_1=your_groq_api_key_1
GROQ_API_KEY_2=your_groq_api_key_2
GROQ_API_KEY_3=your_groq_api_key_3
GROQ_API_KEY_4=your_groq_api_key_4
GROQ_API_KEY_5=your_groq_api_key_5
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — fallback / deeper analysis
OPENROUTER_API_KEY_1=your_openrouter_api_key_1
OPENROUTER_API_KEY_2=your_openrouter_api_key_2
OPENROUTER_MODEL=anthropic/claude-3-haiku

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Local dev:
VITE_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Oracle VM / Docker production:
# PRIMARY_DOMAIN=tradeflex.in
# SERVER_NAMES=tradeflex.in www.tradeflex.in
# APP_PUBLIC_URL=https://tradeflex.in
# VITE_API_URL=
# ALLOWED_ORIGINS=https://tradeflex.in,https://www.tradeflex.in,http://tradeflex.in,http://www.tradeflex.in

# ── LLM Feature Flags ─────────────────────────────────────────────────────────
# Set to "false" to disable LLM rationale (saves API calls during dev)
LLM_SIGNAL_RATIONALE=true
LLM_REGIME_COMMENTARY=true
LLM_POSTMORTEM=true
